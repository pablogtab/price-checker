# Optional settings. Authentication is stored separately by `python scraper.py login`.
COVERWEB_OUTPUT=data/disfit-prices.json
COVERWEB_DELAY=2

# Local Docker Compose ports and database password.
DB_PORT=5442
API_PORT=3215
WEB_PORT=4215
POSTGRES_PASSWORD=local_price_checker
# For npm-based API/worker development:
# DATABASE_URL=postgres://price_checker:local_price_checker@127.0.0.1:5442/price_checker
